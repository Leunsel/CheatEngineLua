{
   Example - Full Capability
   -------------------------
   The living reference for the Manifold TemplateLoader template API.
   Everything used here is available to every template author - no internal
   APIs, no special cases. Pair this file with
   "Example - Full Capability.Settings.lua", which declares the
   Requires/Optional contract and the four Inputs used below.
}
<< Header >>
<< include("Example-Notes") >>

[ENABLE]

{
   << ScanModule >> and << AssertBytes >> adapt to what is loaded: the
   Manifold commands when the framework is present, aobScanModule and a
   comment when it is not. Right now:
     Manifold commands  : << HasManifoldCommands >>
     Trampoline support : << HasManifoldTrampolines >>
}
<< ScanModule >>
<< Alloc >>

<< AssertBytes >>

label(o_<< HookName >> r_<< HookName >><% if UseReadMem then %> z_<< HookName >><% end %>)
label(<< HookName >>Ptr)
<% if RegisterMode == "Both" then %>
label(Player Entity)
<% end %>

n_<< HookName >>:
<% if RegisterMode == "Both" then %>
  // Compare via the register chosen in the input dialog.
  cmp << CompareRegister >>,0
  je Player
  jmp Entity

Player:
  mov [<< HookName >>Ptr],<< BaseAddressRegister >>
  jmp o_<< HookName >>

Entity:
  mov [<< HookName >>Ptr+<< PointerSize >>],<< BaseAddressRegister >>
  jmp o_<< HookName >>
<% else %>
  // Single capture (RegisterMode = << RegisterMode >>).
  // Optional context: BaseAddressOffset is << default(BaseAddressOffset, "unresolved") >>
  // for the operand of: << OriginalInstruction >>
  mov [<< HookName >>Ptr],<< BaseAddressRegister >>
<% end %>

o_<< HookName >>:
<% if UseReadMem then %>
  readMem(<< HookNameParsed >><< AoBOffset >>,<< JumpSize >>)
<% else %>
<< OriginalOpcodes >>
<% end %>
  jmp r_<< HookName >>
<% if UseReadMem then %>

z_<< HookName >>:
  readMem(<< HookNameParsed >><< AoBOffset >>,<< JumpSize >>)
<% end %>

<< HookName >>Ptr:
<%
-- PointerCount comes from the input dialog; hex() is a template helper.
-- Plain Lua drives the loop, the expression below emits each slot.
for slot = 1, PointerCount do
%>
  << PointerType >> 0 // slot << slot >> (offset +<< hex((slot - 1) * PointerSize) >>)
<% end %>

<< HookNameParsed >><< AoBOffset >>:
  << JumpType >> n_<< HookName >>
  << NopPadding >>
r_<< HookName >>:
registersymbol(<< HookNameParsed >> << HookName >>Ptr<% if UseReadMem then %> z_<< HookName >><% end %>)

[DISABLE]

<< HookNameParsed >><< AoBOffset >>:
<% if UseReadMem then %>
  readMem(z_<< HookName >>,<< JumpSize >>)
<% else %>
  db << OriginalBytes >>
<% end %>

unregisterSymbol(*)
dealloc(*)

{
   Generated by << TemplateSettings.Caption >> (schema << TemplateSettings.SchemaVersion >>)
   on << DateTime >> with Manifold TemplateLoader << Version >>.
}
