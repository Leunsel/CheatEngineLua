<< Header >>
<< TrampolineWarning >>
[ENABLE]

<< ScanModule >>
<< GlobalAlloc >>

ManifoldInstallDetour(<< HookName >>,<< HookNameParsed >><< AoBOffset >>,n_<< HookName >>)
<< AssertBytes >>

label(o_<< HookName >>)
label(<< HookName >>Ptr << HookName >>Flag << HookName >>Multiplier)

n_<< HookName >>:
  mov [<< HookName >>Ptr],<< BaseAddressRegister >>
  cmp byte ptr [<< HookName >>Flag],0    // Disabled
  je o_<< HookName >>

  cmp byte ptr [<< HookName >>Flag],1    // Feature
  jne @f
    jmp o_<< HookName >>

  @@:
  cmp byte ptr [<< HookName >>Flag],2    // Multiplier (Default)
  jne @f
    jmp o_<< HookName >>

  @@:
  mov byte ptr [<< HookName >>Flag],0    // Unhandled Case
  jmp o_<< HookName >>

o_<< HookName >>:
  ManifoldEmitOriginal(<< HookName >>)

<< HookName >>Ptr:
  << PointerType >> 0
<< HookName >>Flag:
  db 2
<< HookName >>Multiplier:
  dd (float)0.25

registersymbol(<< HookNameParsed >>)
registersymbol(<< HookName >>Ptr << HookName >>Flag << HookName >>Multiplier)

[DISABLE]

ManifoldDestroyDetour(<< HookName >>)

unregisterSymbol(*)
dealloc(*)
