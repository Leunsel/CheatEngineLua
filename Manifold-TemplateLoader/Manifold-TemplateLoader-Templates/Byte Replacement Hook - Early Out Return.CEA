<< Header >>

[ENABLE]

<< ScanModule >>

<< AssertBytes >>
<% if HasManifoldCommands then %>
ManifoldPatch(<< HookNameParsed >><< AoBOffset >>,B0 01 C3)
<% else %>
<< HookNameParsed >><< AoBOffset >>:
  db B0 01 C3
<% end %>

registersymbol(<< HookNameParsed >>)

[DISABLE]

<% if HasManifoldCommands then %>
ManifoldPatch(<< HookNameParsed >><< AoBOffset >>)
<% else %>
<< HookNameParsed >><< AoBOffset >>:
  db << OriginalBytes >>
<% end %>

unregisterSymbol(*)
